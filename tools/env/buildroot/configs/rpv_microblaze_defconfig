# microblaze-elf: binutils, gcc (C only), libgcc and newlib with multilib,
# which provides the little-endian (le) libraries.
# Only host packages are built (see setup.sh), never a target system.
BR2_x86_64=y
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TOOLCHAIN_BARE_METAL_BUILDROOT=y
BR2_TOOLCHAIN_BARE_METAL_BUILDROOT_ARCH="microblaze-elf"
BR2_TOOLCHAIN_BARE_METAL_BUILDROOT_MULTILIB=y
